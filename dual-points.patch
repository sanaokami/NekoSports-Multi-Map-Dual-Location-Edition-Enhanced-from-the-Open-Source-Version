+    fn settings() -> Settings {
+        Settings::from_text(
+            "39.9000,116.4000\n39.9010，116.4010\n39.9000 116.4020",
+            "39.9005,116.4010",
+            CoordinateSystem::Gcj02,
+            "school-a",
+        )
+        .unwrap()
+    }
