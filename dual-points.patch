+        client.set_test_host("http://127.0.0.1:1".into());
+        let mut logs = Vec::new();
+        let anchor = effective_anchor(&client.identity, "school-a", &config.manual_points).unwrap();
+        let points = super::super::points::fetch_points(&mut client, anchor, &mut |s| {
+            logs.push(s.to_owned())
+        })
+        .unwrap();
+        assert_eq!(points.len(), 1);
+        assert!(logs.iter().any(|s| s.contains("手动点位")));
+        let route = config.manual_points.route_bd("school-a").unwrap();
+        let track = crate::track::generator::build(
+            1200.0,
+            600,
+            7,
+            (anchor.latitude, anchor.longitude),
+            1_700_000_000_000,
+            &route,
+        );
+        track.validate_consistency().unwrap();
+        let wrapper = crate::track::wire::five_point_wrapper(&points, &track, &Default::default());
+        crate::track::wire::validate_five_point_wrapper(&wrapper).unwrap();
+        assert_eq!(
+            std::fs::read_to_string(dir.join("points_cache.json")).unwrap(),
+            "server-cache-sentinel"
+        );
+        client.login.as_mut().unwrap().unid = "school-b".into();
+        assert!(super::super::points::fetch_points(&mut client, anchor, &mut |_| {}).is_err());
+        config.manual_points.enabled = false;
+        super::super::model::save_config(&config).unwrap();
+        client.login.as_mut().unwrap().unid = "school-a".into();
+        assert!(super::super::points::fetch_points(&mut client, anchor, &mut |_| {}).is_err());
+        crate::platform::TEST_DATA_DIR.with(|p| *p.borrow_mut() = None);
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
