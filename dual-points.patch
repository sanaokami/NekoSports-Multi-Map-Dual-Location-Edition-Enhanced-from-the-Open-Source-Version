+    #[test]
+    fn coordinates_round_trip_and_local_points_have_no_server_ids() {
+        let s = settings();
+        let payload = s.payload("school-a").unwrap();
+        for (point, original) in payload.iter().zip(&s.checkin_points) {
+            let bd = super::super::fence::point_xy(point).unwrap();
+            let gcj = crate::track::wire::bd09_to_gcj02(bd.0, bd.1);
+            assert!((gcj.0 - original.latitude).abs() < 1e-6);
+            assert!((gcj.1 - original.longitude).abs() < 1e-6);
+            assert!(point.get("id").is_none());
+        }
+        let saved = serde_json::to_string(&s).unwrap();
+        let restored: Settings = serde_json::from_str(&saved).unwrap();
+        assert_eq!(restored.payload("school-a").unwrap(), payload);
+        assert!(restored.payload("school-b").is_err());
+        assert_eq!(restored.anchor("school-a").unwrap(), s.route_points[0]);
+        let bd = Settings {
+            coordinate_system: CoordinateSystem::Bd09,
+            route_points: s
+                .route_bd("school-a")
+                .unwrap()
+                .into_iter()
+                .map(|p| Coordinate::new(p.0, p.1, 0.).unwrap())
+                .collect(),
+            checkin_points: payload
+                .iter()
+                .map(|v| {
+                    Coordinate::new(v["lat"].as_f64().unwrap(), v["lon"].as_f64().unwrap(), 0.0)
+                        .unwrap()
+                })
+                .collect(),
+            ..s.clone()
+        };
+        assert!(bd
+            .anchor("school-a")
+            .unwrap()
+            .is_near(s.route_points[0], 1e-6));
+        let converted = bd.payload("school-a").unwrap();
+        for (actual, expected) in converted.iter().zip(&payload) {
+            for field in ["lat", "lon", "glat", "glon"] {
+                assert!(
+                    (actual[field].as_f64().unwrap() - expected[field].as_f64().unwrap()).abs()
+                        < 1e-6
+                );
+            }
+        }
+    }
