+//! Explicit, school-scoped local points. Never stored as server point-cache data.
+
+use crate::location::Coordinate;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum CoordinateSystem {
+    #[default]
+    Gcj02,
+    Bd09,
+}
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Settings {
+    pub enabled: bool,
+    pub school_unid: String,
+    pub coordinate_system: CoordinateSystem,
+    // Legacy points are route coordinates only; never infer check-in locations.
+    #[serde(alias = "points")]
+    pub route_points: Vec<Coordinate>,
+    pub checkin_points: Vec<Coordinate>,
+}
+
+impl Settings {
+    pub fn from_text(
+        route: &str,
+        checkin: &str,
+        system: CoordinateSystem,
+        school: &str,
+    ) -> Result<Self, String> {
+        let settings = Self {
+            enabled: true,
+            school_unid: school.to_owned(),
+            coordinate_system: system,
+            route_points: parse_points(route, "定位点", 3, 100)?,
+            checkin_points: parse_points(checkin, "打卡点", 1, 30)?,
+        };
+        settings.validate_for(school)?;
+        Ok(settings)
+    }
+
+    pub fn text(&self) -> String {
+        format_points(&self.route_points)
+    }
+    pub fn checkin_text(&self) -> String {
+        format_points(&self.checkin_points)
+    }
+
+    pub fn validate_for(&self, school: &str) -> Result<(), String> {
+        if school.trim().is_empty() || school != self.school_unid {
+            return Err("手动点位属于其他学校，请为当前学校重新保存或切回服务器点位".into());
+        }
+        validate_points(&self.route_points, "定位点", 3, 100)?;
+        validate_points(&self.checkin_points, "打卡点", 1, 30)?;
+        for point in self.route_points.iter().chain(&self.checkin_points) {
+            let (a, o) = self.bd(point);
+            Coordinate::new(a, o, 0.0)?;
+            let (a, o) = self.gcj(point);
+            Coordinate::new(a, o, 0.0)?;
+        }
+        Ok(())
+    }
+
+    /// Route coordinates retain the order entered by the user (BD-09).
+    pub fn route_bd(&self, school: &str) -> Result<Vec<(f64, f64)>, String> {
+        self.validate_for(school)?;
+        Ok(self.route_points.iter().map(|p| self.bd(p)).collect())
+    }
+
+    fn bd(&self, point: &Coordinate) -> (f64, f64) {
+        match self.coordinate_system {
+            CoordinateSystem::Gcj02 => {
+                crate::track::geom::gcj02_to_bd09(point.latitude, point.longitude)
+            }
+            CoordinateSystem::Bd09 => (point.latitude, point.longitude),
+        }
+    }
+
+    fn gcj(&self, point: &Coordinate) -> (f64, f64) {
+        match self.coordinate_system {
+            CoordinateSystem::Gcj02 => (point.latitude, point.longitude),
+            CoordinateSystem::Bd09 => {
+                crate::track::wire::bd09_to_gcj02(point.latitude, point.longitude)
+            }
+        }
+    }
+
+    pub fn anchor(&self, school: &str) -> Result<Coordinate, String> {
+        self.validate_for(school)?;
+        let (a, o) = self.gcj(&self.route_points[0]);
+        Coordinate::new(a, o, 0.0)
+    }
+
+    pub fn payload(&self, school: &str) -> Result<Vec<Value>, String> {
+        self.validate_for(school)?;
+        Ok(self
+            .checkin_points
+            .iter()
+            .enumerate()
+            .map(|(i, p)| {
+                let (lat, lon) = self.bd(p);
+                let (glat, glon) = self.gcj(p);
+                json!({
+                    "lat": lat, "lon": lon, "glat": glat, "glon": glon,
+                    "pointName": format!("手动打卡点 {}", i + 1),
+                    "isFixed": 0, "isMustPoint": false,
+                })
+            })
+            .collect())
+    }
+}
+
+fn format_points(points: &[Coordinate]) -> String {
+    points
+        .iter()
+        .map(|p| format!("{:.7},{:.7}", p.latitude, p.longitude))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn parse_points(
+    text: &str,
+    label: &str,
+    min: usize,
+    max: usize,
+) -> Result<Vec<Coordinate>, String> {
+    let mut points = Vec::new();
+    for (index, line) in text.lines().enumerate() {
+        let line = line.trim();
+        if line.is_empty() {
+            continue;
+        }
+        let fields: Vec<_> = line
+            .split(|c: char| c == ',' || c == '，' || c.is_whitespace())
+            .filter(|s| !s.is_empty())
+            .collect();
+        let parse = || -> Result<Coordinate, String> {
+            if fields.len() != 2 {
+                return Err("每行填写两个数字：纬度,经度".into());
+            }
+            Coordinate::new(
+                fields[0].parse().map_err(|_| "纬度不是数字")?,
+                fields[1].parse().map_err(|_| "经度不是数字")?,
+                0.0,
+            )
+        };
+        points.push(parse().map_err(|e| format!("{label}第 {} 行：{e}", index + 1))?);
+        if points.len() > max {
+            return Err(format!("{label}最多 {max} 个"));
+        }
+    }
+    validate_points(&points, label, min, max)?;
+    Ok(points)
+}
+
+fn validate_points(
+    points: &[Coordinate],
+    label: &str,
+    min: usize,
+    max: usize,
+) -> Result<(), String> {
+    if !(min..=max).contains(&points.len()) {
+        return Err(format!(
+            "请单独设置 {min} 至 {max} 个{label}；旧版点位仅保留为定位点，请补填打卡点后保存"
+        ));
+    }
+    for (i, point) in points.iter().enumerate() {
+        point
+            .validate()
+            .map_err(|e| format!("{label} {}：{e}", i + 1))?;
+        if point.latitude == 0.0 && point.longitude == 0.0 {
+            return Err(format!("{label} {} 不能为 0,0", i + 1));
+        }
+        if points[..i].iter().any(|p| p.is_near(*point, 1e-6)) {
+            return Err(format!("{label} {} 与前面重复", i + 1));
+        }
+    }
+    Ok(())
+}
+
+/// Manual mode uses its first point as the request anchor without changing device identity.
+pub fn effective_anchor(
+    identity: &super::model::HeaderIdentity,
+    school: &str,
+    settings: &Settings,
+) -> Result<Coordinate, String> {
+    if settings.enabled {
+        settings.anchor(school)
+    } else {
+        identity.anchor_coordinate()
+    }
+}
