+#[cfg(test)]
+mod manual_points_ui_tests {
+    use super::*;
+    use crate::api::{
+        manual_points::{CoordinateSystem, Settings},
+        model,
+    };
+
+    fn frame(app: &mut App, ctx: &egui::Context, events: Vec<egui::Event>) -> egui::FullOutput {
+        ctx.run(
+            egui::RawInput {
+                screen_rect: Some(egui::Rect::from_min_size(
+                    egui::Pos2::ZERO,
+                    egui::vec2(880.0, 720.0),
+                )),
+                events,
+                ..Default::default()
+            },
+            |ctx| {
+                egui::CentralPanel::default().show(ctx, |ui| app.draw_manual_points(ui));
+            },
+        )
+    }
+
+    fn click_button(app: &mut App, ctx: &egui::Context, label: &str) {
+        let output = frame(app, ctx, vec![]);
+        let pos = output
+            .shapes
+            .iter()
+            .find_map(|shape| match &shape.shape {
+                egui::Shape::Text(text) if text.galley.text() == label => {
+                    Some(text.pos + text.galley.size() / 2.0)
+                }
+                _ => None,
+            })
+            .expect("manual settings button must be visible");
+        for pressed in [true, false] {
+            frame(
+                app,
+                ctx,
+                vec![
+                    egui::Event::PointerMoved(pos),
+                    egui::Event::PointerButton {
+                        pos,
+                        button: egui::PointerButton::Primary,
+                        pressed,
+                        modifiers: Default::default(),
+                    },
+                ],
+            );
+        }
+    }
+
+    #[test]
+    fn saved_selection_updates_anchor_invalidates_preview_and_can_restore_server_mode() {
+        struct DataDir(std::path::PathBuf);
+        impl Drop for DataDir {
+            fn drop(&mut self) {
+                crate::platform::TEST_DATA_DIR.with(|p| *p.borrow_mut() = None);
+                let _ = std::fs::remove_dir_all(&self.0);
+            }
+        }
+        let dir = DataDir(
+            std::env::temp_dir().join(format!("manual-points-ui-{}", uuid::Uuid::new_v4())),
+        );
+        std::fs::create_dir_all(&dir.0).unwrap();
+        crate::platform::TEST_DATA_DIR.with(|p| *p.borrow_mut() = Some(dir.0.clone()));
+        let identity = model::HeaderIdentity::default();
+        let original_anchor = identity.anchor_coordinate().unwrap();
+        let device_id = identity.device_id.clone();
+        let session = model::Session {
+            uid: 7,
+            token: "fixture".into(),
+            unid: "school-a".into(),
+            ..Default::default()
+        };
+        let context = egui::Context::default();
+        let mut app = App::from_state(
+            &context,
+            identity,
+            session.clone(),
+            model::Config::default(),
+        );
+        app.run_page.preview_key = "previous-preview".into();
+        let settings = Settings::from_text(
+            "39.9,116.4\n39.901,116.401\n39.9,116.402",
+            "39.9005,116.401",
+            CoordinateSystem::Gcj02,
+            &session.unid,
+        )
+        .unwrap();
+        app.apply_manual_points(settings).unwrap();
+        assert_eq!(app.run_anchor().unwrap().latitude, 39.9);
+        assert!(app.run_page.preview_key.is_empty());
+        assert_eq!(app.identity.device_id, device_id);
+        assert_eq!(app.identity.anchor_coordinate().unwrap(), original_anchor);
+        let config = model::load_config();
+        assert!(config.manual_points.enabled);
+        let restored = App::from_state(
+            &egui::Context::default(),
+            app.identity.clone(),
+            session,
+            config,
+        );
+        assert_eq!(restored.run_page.manual_points_text.lines().count(), 3);
+        assert_eq!(restored.run_page.manual_checkin_text.lines().count(), 1);
+        assert_eq!(restored.run_anchor().unwrap(), app.run_anchor().unwrap());
+        app.run_page.manual_checkin_text.clear();
+        click_button(&mut app, &context, "保存并启用手动点位");
+        assert!(app.run_page.manual_points_status.contains("打卡点"));
+        assert_eq!(model::load_config().manual_points.checkin_points.len(), 1);
+        app.run_page.manual_points_text = "invalid".into();
+        click_button(&mut app, &context, "保存并启用手动点位");
+        assert!(app.run_page.manual_points_status.contains("第 1 行"));
+        assert_eq!(model::load_config().manual_points.route_points.len(), 3);
+        app.session.as_mut().unwrap().unid = "school-b".into();
+        assert!(app.run_anchor().is_err());
+        click_button(&mut app, &context, "使用服务器点位");
+        assert!(!model::load_config().manual_points.enabled);
+        assert_eq!(app.run_anchor().unwrap(), original_anchor);
+    }
+}
